<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Outer radar pulse wave -->
    <path
        android:pathData="M32,42 A26,26 0 0,1 76,42"
        android:strokeWidth="2.5"
        android:strokeColor="#38BDF8"
        android:strokeLineCap="round"
        android:fillColor="#00000000" />
    <path
        android:pathData="M24,34 A36,36 0 0,1 84,34"
        android:strokeWidth="2.0"
        android:strokeColor="#2563EB"
        android:strokeLineCap="round"
        android:fillColor="#00000000" />

    <!-- RouteWake Pin / Beacon body -->
    <path
        android:pathData="M54,26 C43.5,26 35,34.5 35,45 C35,58.5 52,78 54,80 C56,78 73,58.5 73,45 C73,34.5 64.5,26 54,26 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="35"
                android:startY="26"
                android:endX="73"
                android:endY="80"
                android:type="linear">
                <item android:offset="0.0" android:color="#38BDF8" />
                <item android:offset="0.6" android:color="#2563EB" />
                <item android:offset="1.0" android:color="#1D4ED8" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Inner core alert beacon (Amber / Gold alarm indicator) -->
    <path
        android:pathData="M54,45m-7,0a7,7 0 1,1 14,0a7,7 0 1,1 -14,0"
        android:fillColor="#0B132B" />

    <path
        android:pathData="M54,45m-4.5,0a4.5,4.5 0 1,1 9,0a4.5,4.5 0 1,1 -9,0">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="50"
                android:startY="41"
                android:endX="58"
                android:endY="49"
                android:type="linear">
                <item android:offset="0.0" android:color="#F59E0B" />
                <item android:offset="1.0" android:color="#D97706" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Sleek inner center dot -->
    <path
        android:pathData="M54,45m-1.5,0a1.5,1.5 0 1,1 3,0a1.5,1.5 0 1,1 -3,0"
        android:fillColor="#FEF3C7" />
</vector>
